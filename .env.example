MC_IMPLEMENTATION_ADDRESS=0x3C143D14E7Cfd3b50774C27b2cd1bCE79F7e484A

# ONCHAINID Infrastructure
ID_FACTORY_ADDRESS=0xB68Fdd53DF4C19E4cb3e71F491a539D891a226c8
OID_IDENTITY_IMPLEMENTATION=0xe9d398fD39F317b32fF87567DD495D1d1C8fA060
OID_IA_ADDRESS=0xE06169b3403B68e793d02674287986de1915d67A

# Platform ClaimIssuer (issues KYC claims onto investor identities)
CLAIM_ISSUER_ADDRESS=0x020Ddc56A341991b5F9B84b5E3D4d5ea2D9565d1
# Private key used by backend to sign KYC claims (same as deployer — ClaimIssuer owner)
CLAIM_ISSUER_PRIVATE_KEY=

# Gateways
TREX_GATEWAY_ADDRESS=0x2920b74e7726d90182d299f2DDE49EE232B543AE
OID_GATEWAY_ADDRESS=0x0c538A82d90787D84216093B57A88d6407c471CB

# Compliance Modules
COUNTRY_RESTRICT_MODULE_ADDRESS=0x323eE5047b12b08a17112A99b77195Ab45477B37
MAX_HOLDER_MODULE_ADDRESS=0x532f8651815fbA51CBbE894B83302B93B9D5d370
