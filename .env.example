NEXT_PUBLIC_SENDER_WHITELIST_MODULE_ADDRESS=0xE420d6A57817F1424b89cB911464997b1c106E64

# Wallet Connect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=2d7ded4b2b1becfe9064b344d8c4ba63

# Platform backend agent — deployer EOA, added to irAgents+tokenAgents at token deploy time
NEXT_PUBLIC_PLATFORM_AGENT_ADDRESS=0xea2Fe42e772784807C33DF5FD7D25D7021244048

# Frontend URLs
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_INVESTOR_URL=http://localhost:3001
NEXT_PUBLIC_ISSUER_URL=http://localhost:3002
NEXT_PUBLIC_ADMIN_URL=http://localhost:3003

# Encryption
ENCRYPTION_KEY=your_32_char_encryption_key_here

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=120

CORS_ORIGINS=http://localhost:3001,http://localhost:3002,http://localhost:3003

