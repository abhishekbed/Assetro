MAX_BALANCE_MODULE_ADDRESS=0x53C959590e5Ab3Fa6EE0Fa581F53b44A80994572
DAY_MONTH_LIMITS_MODULE_ADDRESS=0x65052e34413591852BEee1381c3756f8242D0cB2
EXCHANGE_MONTHLY_LIMITS_MODULE_ADDRESS=0x7542D2f42F240977e2E5918e3b9706Fc1CC736f8
TRANSFER_FEE_MODULE_ADDRESS=0x9E54085E29420D961df6B97B48848Dd888d30AF1
SENDER_WHITELIST_MODULE_ADDRESS=0xE420d6A57817F1424b89cB911464997b1c106E64

# Module addresses exposed to frontend (required for on-chain binding at token creation)
NEXT_PUBLIC_COUNTRY_RESTRICT_MODULE_ADDRESS=0x323eE5047b12b08a17112A99b77195Ab45477B37
NEXT_PUBLIC_MAX_HOLDER_MODULE_ADDRESS=0x532f8651815fbA51CBbE894B83302B93B9D5d370
NEXT_PUBLIC_TRANSFER_WINDOW_MODULE_ADDRESS=0x73723068b9ab181932c894Cc9E861Bab5E7c17b5
NEXT_PUBLIC_SUPPLY_LIMIT_MODULE_ADDRESS=0xA6b7895E981EE1A6ccFE1787Fe344fEaB41Bd65f
NEXT_PUBLIC_MAX_BALANCE_MODULE_ADDRESS=0x53C959590e5Ab3Fa6EE0Fa581F53b44A80994572
NEXT_PUBLIC_DAY_MONTH_LIMITS_MODULE_ADDRESS=0x65052e34413591852BEee1381c3756f8242D0cB2
