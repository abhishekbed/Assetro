# ========================================
# Assetro Platform - Environment Variables
# ========================================

# General
NODE_ENV=development
PORT=3000

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=assetro
DB_PASSWORD=assetro_dev_password
DB_NAME=assetro_platform
DB_SCHEMA=tenant_demo
DB_SSL=false

# Database - MongoDB (DocumentDB)
MONGODB_URI=mongodb://localhost:27017/assetro

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=assetro-documents
AWS_SES_FROM_EMAIL=noreply@assetro.com

# Blockchain - Mode
BLOCKCHAIN_MODE=live

# Blockchain - RPC URLs
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
BHARAT_RPC_URL=https://bharat-rpc-url.com
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/8F4IJh0YDT7PybppBvTCkVGQzowUuVl6
NEXT_PUBLIC_ETHEREUM_TESTNET_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/8F4IJh0YDT7PybppBvTCkVGQzowUuVl6
NEXT_PUBLIC_RPC_URL_11155111=https://eth-sepolia.g.alchemy.com/v2/8F4IJh0YDT7PybppBvTCkVGQzowUuVl6

# Blockchain - Deployer
DEPLOYER_PRIVATE_KEY=

