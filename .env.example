# ========================================
# Assetro Platform - Environment Variables
# ========================================

# General
NODE_ENV=development
PORT=3000

# Database - PostgreSQL
DB_HOST=localhost
DB_PORT=5434
DB_USERNAME=assetro
DB_PASSWORD=assetro_dev_password
DB_NAME=assetro_platform
DB_SCHEMA=tenant_demo
DB_SSL=false

# Database - MongoDB (DocumentDB)
MONGODB_URI=mongodb://localhost:27017/assetro

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# AWS
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=assetro-documents
AWS_SES_FROM_EMAIL=noreply@assetro.com

# Blockchain - Mode
BLOCKCHAIN_MODE=live

# Blockchain - RPC URLs
# The API currently reads SEPOLIA_RPC_URL for live chain calls; set it to the Arc RPC.
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY
POLYGON_RPC_URL=https://polygon-rpc.com
BHARAT_RPC_URL=https://bharat-rpc-url.com
SEPOLIA_RPC_URL=https://rpc.testnet.arc.network

# Blockchain - Deployer
DEPLOYER_PRIVATE_KEY=

# ─── Arc Testnet deployment (chainId 5042002) ──────────────────────────────

# T-REX Infrastructure
TREX_FACTORY_ADDRESS=0x7a43052578aE04c47b12062ecbA4c9BF8dF17E59
TREX_IA_ADDRESS=0xdc3D19D7355b2eF5F1D9f2bf751dB1F0ef5Ade0D
IA_FACTORY_ADDRESS=0x1D7220BeFa9A8893b000bCBEe35374a511C9c776

# T-REX Implementations
TOKEN_IMPLEMENTATION_ADDRESS=0xDe38e006001ed87f27cE3024c0D4aA2474AC56B9
CTR_IMPLEMENTATION_ADDRESS=0xB463653e5e3B0836A45864094eaaa2b44979FC96
IR_IMPLEMENTATION_ADDRESS=0x32420Ff4ADF571E6d9F8E50977f469c9862F0a20
IRS_IMPLEMENTATION_ADDRESS=0x2281aa9Da670a6A2D64b6096a0d4126920bBEb9f
