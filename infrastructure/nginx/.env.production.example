# ============================================================
# Assetro Platform – Production Environment Variables
# Copy this file to each service directory as .env
# ============================================================

# ── Database ────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=assetro
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_DATABASE=assetro_platform

# ── JWT ─────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32_CHAR_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ── Blockchain ──────────────────────────────────────────────
BLOCKCHAIN_MODE=local
# For testnet: BLOCKCHAIN_MODE=testnet
# SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_KEY
# DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# ── Stripe ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_CHANGE_ME

# ── AWS / File Storage ───────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_S3_BUCKET=assetro-documents-demo

# ── App URLs ─────────────────────────────────────────────────
CORS_ORIGINS=https://investor.demo.assetro.com,https://issuer.demo.assetro.com,https://admin.demo.assetro.com
NEXT_PUBLIC_API_URL=https://api.demo.assetro.com/api/v1

# ── Service Ports ────────────────────────────────────────────
PORT=3010   # Change per service: 3010, 3020, 3030, 3040, 3060, 3070, 3080
