# =============================================================================
# Assetro Platform - Docker Compose Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values for your environment.
# DO NOT commit .env files to version control.
# =============================================================================

# -- PostgreSQL -----------------------------------------------------------------
POSTGRES_USER=assetro
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=assetro_platform
POSTGRES_PORT=5432

# -- MongoDB --------------------------------------------------------------------
MONGODB_ROOT_USERNAME=assetro
MONGODB_ROOT_PASSWORD=change_me_in_production
MONGODB_DATABASE=assetro_logs
MONGODB_PORT=27017

# -- Redis ----------------------------------------------------------------------
REDIS_PASSWORD=change_me_in_production
REDIS_PORT=6379

# -- RabbitMQ -------------------------------------------------------------------
RABBITMQ_USER=assetro
RABBITMQ_PASSWORD=change_me_in_production
RABBITMQ_VHOST=assetro
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# -- LocalStack (S3) ------------------------------------------------------------
LOCALSTACK_PORT=4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
S3_BUCKET_NAME=assetro-documents
